# Example environment variables for KV Cognition API

# Optional: Redis connection (if using caching)
REDIS_URL=

# Optional: vLLM Configuration
VLLM_HOST=127.0.0.1
VLLM_PORT=8001

# Optional: OpenAI API Key (if proxying to OpenAI)
OPENAI_API_KEY=

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=production
